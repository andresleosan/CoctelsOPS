{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "sudo *": "ask",
      "*migrate*": "ask",
      "*--prod*": "ask",
      "cat *.env*": "ask",
      "cat *secret*": "ask",
      "cat *credential*": "ask",
      "env": "ask",
      "printenv*": "ask",
      "history": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    }
  }
}
